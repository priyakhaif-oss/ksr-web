# Required: MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ksr_diary_foods
# Set a strong admin password in Vercel Environment Variables
ADMIN_PASSWORD=replace-with-a-long-private-password
# Optional: paste the direct ImageBB image URL (usually https://i.ibb.co/.../image.jpg)
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BUFFALO_MILK_IMAGE=
NEXT_PUBLIC_COW_MILK_IMAGE=
NEXT_PUBLIC_PREMIUM_BUFFALO_MILK_IMAGE=
